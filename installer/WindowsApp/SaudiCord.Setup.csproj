<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SaifCord.Setup</AssemblyName>
    <RootNamespace>SaifCord.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../payload/node.exe" LogicalName="SaifCord.Payload.node.exe" />
    <EmbeddedResource Include="../payload/install.mjs" LogicalName="SaifCord.Payload.install.mjs" />
    <EmbeddedResource Include="../payload/asar.mjs" LogicalName="SaifCord.Payload.asar.mjs" />
    <EmbeddedResource Include="../payload/saifcord.asar" LogicalName="SaifCord.Payload.saifcord.asar" />
  </ItemGroup>
</Project>