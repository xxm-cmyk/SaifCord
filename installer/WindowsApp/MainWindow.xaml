<Window x:Class="SaudiCord.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SaudiCord Setup" Width="1040" Height="760" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#080C09" Foreground="#F2F7F3"
        FontFamily="Segoe UI" ResizeMode="CanResize" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EFFFF4"/>
            <Setter Property="Background" Value="#14251B"/>
            <Setter Property="BorderBrush" Value="#28563A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" TextElement.TextWrapping="Wrap"
                                              TextElement.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1B3826"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#36E879"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#21452E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Canvas x:Name="GridCanvas" IsHitTestVisible="False" Opacity="0.7"/>
        <Grid Margin="36,78,36,36">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#153321" Margin="0,0,14,0">
                        <TextBlock Text="S" Foreground="#48F18A" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SAUDICORD" FontSize="19" FontWeight="Bold" Foreground="#F2FFF6"/>
                        <TextBlock Text="WINDOWS INSTALLER  •  V1.00" FontSize="10" Foreground="#7E9A88" Margin="1,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙  الإعدادات"
                        Style="{StaticResource ActionButton}" Padding="18,10" MinHeight="42"
                        MinWidth="132" Click="SettingsButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تجربة Discord،&#xA;بهوية سعودية."
                               FontSize="38" FontWeight="Bold" LineHeight="50"
                               Foreground="#F4FFF7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="ثبّت SaudiCord أو أصلح التثبيت الحالي أو أزله بأمان."
                               FontSize="14" Foreground="#A9B9AE" TextWrapping="Wrap"
                               LineHeight="22" Margin="0,0,0,20"/>
                    <Border Grid.Row="2" Background="#101913" BorderBrush="#294B35"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="طريقة التثبيت" Foreground="#A8B8AD" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="يُطبّق SaudiCord مباشرة على نسخة Discord Stable المثبّتة على جهازك، مع الاحتفاظ بنسخة الاستعادة."
                                       Foreground="#DCEBE0" FontSize="13" TextWrapping="Wrap"
                                       LineHeight="20" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="3">
                        <Button x:Name="InstallButton" Content="⬇   تثبيت SaudiCord"
                                Style="{StaticResource ActionButton}" Background="#176B37"
                                BorderBrush="#36E879" Margin="0,0,0,10" Click="InstallButton_Click"/>
                        <Button x:Name="RepairButton" Content="⟳   إصلاح / إعادة تثبيت"
                                Style="{StaticResource ActionButton}" Margin="0,0,0,10"
                                Click="RepairButton_Click"/>
                        <Button x:Name="UninstallButton" Content="－   إزالة SaudiCord واستعادة Discord"
                                Style="{StaticResource ActionButton}" Click="UninstallButton_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="#101713" BorderBrush="#203B2A"
                        BorderThickness="1" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="إدارة Discord" FontSize="17"
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="إغلاق النسخ المفتوحة قبل التثبيت أو الإصلاح."
                                   Foreground="#91A49A" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="19" Margin="0,0,0,16"/>
                        <Button Grid.Row="2" x:Name="KillButton" Content="✕   إغلاق Discord بالكامل"
                                Style="{StaticResource ActionButton}" Click="KillButton_Click"/>
                        <Separator Grid.Row="3" Background="#294033" Margin="0,20,0,16"/>
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="سجل العمليات" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     Background="#090E0B" Foreground="#A8E8BA"
                                     BorderBrush="#203B2A" Padding="11" MinHeight="170"
                                     FontFamily="Consolas" FontSize="11"/>
                        </Grid>
                        <ProgressBar Grid.Row="5" x:Name="ActivityBar" Height="5"
                                     Margin="0,16,0,0" IsIndeterminate="False"
                                     Foreground="#36E879" Background="#203B2A"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SaudiCord • أداة تثبيت مستقلة لويندوز"
                           Foreground="#718579" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Windows 10 / 11  •  x64"
                           Foreground="#718579" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Border x:Name="SettingsOverlay" Visibility="Collapsed" Background="#E9080C09">
            <Border Width="460" MaxWidth="460" Margin="24" Padding="28"
                    Background="#101713" BorderBrush="#36E879" BorderThickness="1"
                    CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="الإعدادات" FontSize="22" FontWeight="Bold" Margin="0,0,0,22"/>
                    <CheckBox x:Name="AnimationToggle" Content="تعطيل حركة المربعات للأجهزة الضعيفة"
                              Foreground="#E8F5EC" FontSize="13" IsChecked="False"
                              TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock Text="عند تعطيل الحركة تبقى الشبكة ثابتة لتقليل استهلاك الموارد."
                               Foreground="#91A49A" FontSize="12" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,0,0,22"/>
                    <Button Content="حفظ وإغلاق" Style="{StaticResource ActionButton}"
                            Click="CloseSettings_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
        <Grid x:Name="TitleBar" Height="48" Margin="12,8,12,0"
              VerticalAlignment="Top" Background="#101713" Panel.ZIndex="20"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="25" Height="25" CornerRadius="7" Background="#153321" Margin="0,0,9,0">
                    <TextBlock Text="S" Foreground="#48F18A" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SaudiCord Setup" Foreground="#DCEBE0" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                        Width="46" Background="Transparent" Foreground="#A9B9AE"
                        BorderThickness="0" FontSize="11" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26382D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                        Width="46" Background="Transparent" Foreground="#A9B9AE"
                        BorderThickness="0" FontSize="10" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26382D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="CloseWindowButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        Width="48" Background="Transparent" Foreground="#A9B9AE"
                        BorderThickness="0" FontSize="11" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindowButton_Click">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C93636"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
        </Grid>
</Window>